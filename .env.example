# Postgres connection (see docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scaffold

# Object storage (see docker-compose.yml `garage` service). Garage is
# S3-compatible, so the same vars work against AWS S3 in production by pointing
# STORAGE_ENDPOINT at AWS and setting STORAGE_FORCE_PATH_STYLE=false.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_BUCKET=scaffold-documents
STORAGE_ACCESS_KEY_ID=GK97bcef0d8a1e2c3d4e5f60718293a4b5c
STORAGE_SECRET_ACCESS_KEY=27f2c8b9d01a4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e
STORAGE_FORCE_PATH_STYLE=true

# Email: leave unset to print sign-in codes to the server terminal
# The email copy (from, subject, body) is set in code via EmailCodeTemplate —
# see apps/web/src/api/auth.live.ts and the README "Branding the sign-in email".
RESEND_API_KEY=

# OAuth (all optional; unset providers simply don't appear on the sign-in page)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/oauth/linkedin/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth/github/callback
GITHUB_USER_AGENT=scaffold
